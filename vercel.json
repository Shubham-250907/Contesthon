{
  "version": 2,
  "buildCommand": "cd contesthon-frontend && npm install && npm run build",
  "outputDirectory": "contesthon-frontend/dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
